# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact public origin, without a trailing path. Local example below.
APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
RESEND_API_KEY=
# Must use a domain verified in Resend.
RESEND_FROM=
ADMIN_EMAIL=chemizenlabs@gmail.com
# Accepts https://forms.gle/... or https://docs.google.com/forms/...
GOOGLE_FORM_URL=
