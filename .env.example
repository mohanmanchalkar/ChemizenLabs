# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact public origin, without a trailing path. Local example below.
APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
RESEND_API_KEY=
# Must use a domain verified in Resend.
RESEND_FROM=
ADMIN_EMAIL=chemizenlabs@gmail.com
# Legacy setting. Programme enrolment links now live in src/lib/programmes.ts.
# /register always shows both programmes before opening their Google Forms.
GOOGLE_FORM_URL=
# Optional Cloudflare Turnstile CAPTCHA for reviews and enquiries.
# Set BOTH keys to activate; configure your website hostname in Cloudflare.
# Use official test keys only in development. Restart after changing either key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
